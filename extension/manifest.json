{
  "manifest_version": 3,
  "name": "Mia — Save words while you read",
  "version": "0.1.0",
  "description": "Select any word on any page — Mia saves it with its sentence, shows a plain-English meaning + 中文, and weaves it back into your AI tutoring sessions.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mia vocabulary"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}