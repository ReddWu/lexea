{
  "manifest_version": 3,
  "name": "Echowords — Save words while you read",
  "version": "0.3.4",
  "description": "Select a word or phrase on any page — Echowords saves it with its sentence, explains it, and tutors you on it later.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Echowords vocabulary",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://mia-tutor.vercel.app/*",
    "https://kv54z32g.us-east.insforge.app/*",
    "http://localhost:3002/*"
  ],
  "key": ""
}
