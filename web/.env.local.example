# Copy to .env.local (local dev) and set the same vars in Vercel (Project → Settings → Environment Variables).

# Supabase project URL and publishable key (Project Settings → API Keys).
# The publishable key is safe to expose; RLS protects every row.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: protect the site with a password. Leave unset/empty to make the site open.
APP_PASSWORD=
